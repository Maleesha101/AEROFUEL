# AEROFUEL development configuration
# Never place real credentials in this file.

COMPOSE_PROJECT_NAME=aerofuel

# Public gateway
GATEWAY_PORT=8080

# Database
POSTGRES_DB=aerofuel
POSTGRES_USER=aerofuel
POSTGRES_PASSWORD=change-me-for-local-development

# Internal service configuration
MANIFEST_WORKER_PORT=8081
OPS_API_PORT=8082
AUDIT_SERVICE_PORT=8083

# Challenge configuration
CHALLENGE_ENV=development
